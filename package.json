{
  "name": "escalads-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:web dev:api",
    "dev:web": "npm run dev --workspace @escalads/web",
    "dev:api": "npm run dev --workspace @escalads/api",
    "dev:extension": "npm run dev --workspace @escalads/extension",
    "lint": "npm-run-all lint:web lint:api",
    "lint:web": "npm run lint --workspace @escalads/web",
    "lint:api": "npm run lint --workspace @escalads/api",
    "build": "npm-run-all build:web build:api",
    "build:web": "npm run build --workspace @escalads/web",
    "build:api": "npm run build --workspace @escalads/api",
    "typecheck": "npm-run-all typecheck:web typecheck:api",
    "typecheck:web": "npm run typecheck --workspace @escalads/web",
    "typecheck:api": "npm run typecheck --workspace @escalads/api"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.0"

}
