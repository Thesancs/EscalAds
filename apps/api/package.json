{
    "name":  "@escalads/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch ./src/index.ts",
                    "build":  "tsc --project tsconfig.build.json",
                    "start":  "node ./dist/index.js",
                    "lint":  "eslint \"src/**/*.{ts,tsx}\"",
