                         "@fastify/swagger":  "^8.15.0",
                         "@fastify/swagger-ui":  "^1.8.1",
                         "@supabase/supabase-js": "^2.48.0",
                         "bcryptjs":  "^2.4.3",
                         "bullmq":  "^5.30.2",
                         "dotenv":  "^16.5.0",
                         "fastify":  "^5.1.0",
                         "fastify-plugin":  "^5.0.1",
                         "ioredis":  "^5.4.1",
                         "minio":  "^8.0.1",
                         "pino":  "^9.5.0",
                         "pino-pretty":  "^11.2.2",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.7.4","eslint":  "^9.17.0",
                            "eslint-config-prettier":  "^9.1.0",
