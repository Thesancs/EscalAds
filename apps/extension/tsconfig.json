
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["dom", "es2021"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
